# ==============================================================================
# Nyaitter サーバー基本設定ファイル (.env)
# このファイルをコピーして .env という名前に変更して使います。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. サーバーの基本設定
# ------------------------------------------------------------------------------
# サーバーが使うポート番号
PORT=3000

# 待ち受けるホスト。未設定なら全インターフェース (0.0.0.0 / [::]) で待ち受けます。
# リバースプロキシの背後で直接公開しない場合は 127.0.0.1 を指定します。
# HOST=127.0.0.1

# host:port 形式でまとめて指定することもできます (PORT より優先されます)。
# NYAITTER_BIND=0.0.0.0:3000

# リバースプロキシの背後で動かす場合だけ true にします。
# 信頼するプロキシのホップ数やサブネット (1, loopback, 10.0.0.0/8) も指定できます。
# TRUST_PROXY=true

# 公開するURL。クローラー向けOGPや共有リンクの基準になります。
# 本番では必須です。host:port だけの指定はできません。
# PUBLIC_URL=https://nyaitter.example.com

# ユーザーファイルを専用ポートで配信する場合だけ設定します。
# 待ち受けホストをメインと変えたい場合だけ NYAITTER_USER_FILES_HOST も設定します。
# NYAITTER_USER_FILES_PORT=3001
# NYAITTER_USER_FILES_HOST=127.0.0.1

# Discord や SNS に投稿リンクを貼ったときに、投稿内容や画像を表示させるポート番号
# メインと同じホストで待ち受けます。変える場合は NYAITTER_POST_SHARE_HOST も設定します。
POST_SHARE_PORT=3000
# POST_SHARE_URL=https://share.example.com
# NYAITTER_POST_SHARE_HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. データの保存先
# ------------------------------------------------------------------------------
# 保存先の種類: 'memory' (再起動で消えるテスト用), 'postgres' (本番用), 'd1' (Cloudflare D1)
DB_ADAPTER=postgres

# PostgreSQL の接続情報
DATABASE_URL=postgresql://ユーザー名:パスワード@ホスト名:5432/データベース名?sslmode=require

# ------------------------------------------------------------------------------
# 3. 画像やファイルの保存先
# ------------------------------------------------------------------------------
# 保存先の種類: 'local' (サーバー内に保存), 'r2' (Cloudflare R2 に保存)
STORAGE_ADAPTER=local

# 1人あたりの画像保存上限
STORAGE_USER_QUOTA_MB=512

# Cloudflare R2 に保存する場合だけ設定します (STORAGE_ADAPTER=r2)
# R2_ACCOUNT_ID=あなたのAccount ID
# R2_BUCKET=バケット名
# R2_ACCESS_KEY_ID=アクセスキーID
# R2_SECRET_ACCESS_KEY=シークレットアクセスキー
# R2_PUBLIC_DOMAIN=https://media.example.com

# 画像の配信先をサーバーの外に置く場合だけ設定します
# NYAITTER_USER_FILES_ENDPOINT=https://media.example.com

# すべての接続元からのCORSを許可する場合のみ true にします。
# 本番環境では、許可する接続元を個別に指定することを推奨します。
ARROW_UNKNOWN_CLIENT=false

# ------------------------------------------------------------------------------
# 4. ログイン方法の設定 (true で使う / false で使わない)
# ------------------------------------------------------------------------------
# Scratch アカウントでのログイン
AUTH_METHOD_SCRATCH_ENABLED=true

# パスキーでのログイン
AUTH_METHOD_PASSKEY_ENABLED=true

# メールアドレス認証でのログイン
AUTH_METHOD_EMAIL_ENABLED=false

# メール送信サーバーを自分で立てる場合だけ設定します。
# 待ち受けホスト・ポートは独立して指定できます (既定: 0.0.0.0:2525)。
# EMBEDDED_MAIL_SERVER_ENABLED=true
# EMBEDDED_MAIL_SERVER_HOST=0.0.0.0
# EMBEDDED_MAIL_SERVER_PORT=2525
# 外部SMTPに中継する場合のホスト名
# EMBEDDED_MAIL_HOSTNAME=mail.example.com
# 外部SMTPへ直接配送する場合
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587

# Google アカウントでのログイン（OAuth 2.0 + PKCE）
# AUTH_METHOD_GOOGLE_ENABLED=true
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=https://nyaitter.example.com/?oauth=google

# Microsoft アカウントでのログイン（OAuth 2.0 + PKCE）
# AUTH_METHOD_MICROSOFT_ENABLED=true
# MICROSOFT_CLIENT_ID=your-microsoft-client-id
# MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
# MICROSOFT_REDIRECT_URI=https://nyaitter.example.com/?oauth=microsoft
# MICROSOFT_TENANT=common

# 信頼済みIPハッシュ用のシークレット鍵
# LOGIN_SECURITY_HMAC_SECRET=your-random-hmac-secret-key-here

# 不明な場所からのログインで締め出されたときのアカウントアクセス復旧
AUTH_ACCOUNT_RECOVERY_ENABLED=true
# 信頼度が最も高い場合の待機時間（時間）
AUTH_ACCOUNT_RECOVERY_MIN_WAIT_HOURS=24
# 信頼度が最も低い場合の待機時間（時間）
AUTH_ACCOUNT_RECOVERY_MAX_WAIT_HOURS=168
# 「不明な場所からの復旧依頼」通知を送る間隔（時間）
AUTH_ACCOUNT_RECOVERY_NOTIFICATION_INTERVAL_HOURS=24

# ------------------------------------------------------------------------------
# 5. AI による不適切な投稿の自動チェック (AutoMod)
# ------------------------------------------------------------------------------
# 利用するAIサービスをJSON配列で登録します。モデル名は利用可能なものに変更してください。
# AI_PROVIDERS=[{"type":"openai","apikey":"","defmodel":"gpt-6-sol","roumodels":["gpt-6-luna"]},{"type":"gemini","apikey":""},{"type":"antigravity"},{"type":"codex"},{"type":"opencode"}]
# AI_MODEL_DB_PATH=data/models.json
# AI_WORK_DIR=data/ai/requests
AUTOMOD_AI_PROVIDER=auto
# AUTOMOD_AI_MODEL=gpt-6-sol
AUTOMOD_PROMPT=基本的には緩めに判断してください。過度に不適切な場合のみ対応するようにしてください。
