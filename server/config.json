{
	"server": {
		"port": 3000,
		"jsonBodyLimit": "7mb",
		"trustProxy": false,
		"apiEndpoint": "/server"
	},
	"userFiles": {
		"port": null
	},
	"static": {
		"jsCssCacheMaxAge": 3600,
		"assetCacheMaxAge": 86400
	},
	"client": {
		"repository": "Nyaitter/Client"
	},
	"cors": {
		"allowedOrigins": ["http://localhost:3000", "http://127.0.0.1:3000"],
		"allowUnknownClient": false,
		"credentials": false,
		"preflightMaxAge": 600
	},
	"limits": {
		"postContentLength": "..1000",
		"dmContentLength": "..2000",
		"dmE2eEphemeralKeyLength": "1..1024",
		"dmE2eCiphertextLength": "1..16384",
		"dmE2ePayloadLength": "..65536",
		"userNameLength": "1..50",
		"profileBioLength": "..500",
		"scratchUsernameLength": "3..20",
			"timelinePageSize": 30,
			"impostersPerParent": 5,
			"userSearchPageSize": "1..100",
		"userSearchDefaultLimit": 20,
		"dmMessagesPageSize": "1..100",
		"dmMessagesDefaultLimit": 50,
		"followingPageSize": 100,
		"parentPostPreviewLength": 100,
		"maxFileUploadSizeMB": 5,
		"fileDeleteBatchSize": 1000,
		"postBatchSize": 100,
		"storageListPageSize": 500
		},
		"dm": {
			"e2eEnabled": false
		},
				"imageUpload": {
			"maxWidth": 2560,
			"maxHeight": 2560,
			"maxPixels": 40000000,
			"maxOutputSizeMB": 5,
			"webpQuality": 82,
			"minWebpQuality": 60
		},
		"geminiModeration": {
			"apiKey": "",
			"model": "",
			"prompt": "",
			"maxImages": 0
		},
		"auth": {
			"sessionExpiryDays": 30,
			"verificationCodeExpiryMinutes": 15,
			"botTokenPrefix": "bot_",
			"sessionTokenBytes": 32,
			"botTokenIdBytes": 16,
			"verificationCodeBytes": 4,
			"methods": {
				"scratch": {
					"enabled": true,
					"verificationProjectId": "1239738451",
					"ipRestrictionEnabled": true,
					"rejectNewScratcher": true,
					"rejectStudentAccounts": true,
					"minQualifiedFollowers": 25
				},
				"passkey": {
					"enabled": false,
					"rpName": "Nyaitter",
					"rpId": "localhost",
					"origin": "http://localhost:3000"
				},
				"email": {
					"enabled": true,
					"codeExpiryMinutes": 10,
					"codeLength": 6,
					"smtp": {
						"host": "",
						"port": 587,
						"secure": false,
						"user": "",
						"pass": "",
						"from": "noreply@localhost"
					},
					"embeddedServer": {
						"enabled": false,
						"port": 2525,
						"host": "0.0.0.0",
						"directDelivery": false,
						"hostname": "localhost"
					}
				},
				"oauth": {
					"enabled": false,
					"providers": {}
				},
				"password": {
					"enabled": false
				}
			},
			"scratchVerification": {
				"ipRestrictionEnabled": true,
				"rejectNewScratcher": true,
				"rejectStudentAccounts": true,
				"minQualifiedFollowers": 25
			}
		},
	"inMemory": {
		"initialUserId": 0
	},
	"database": {
		"adapter": "memory",
					"postgres": {
				"connectionString": "postgres://user:pass@localhost:5432/nyaitter",
				"poolSize": 25,
				"poolMin": 5,
					"poolIdleTimeoutMs": 300000,
					"poolMaxLifetimeSeconds": 1800,
					"connectionTimeoutMs": 15000,
				"transactionRetries": 5,
				"retryBaseDelayMs": 50,
				"ssl": false,
				"sslCa": ""
			},
			"d1": {

			"workerUrl": "",
			"authToken": ""
		}
	},
		"storage": {
			"adapter": "local",
			"userQuotaMB": 1024,
		"local": {
			"uploadDir": "./uploads"
		},
		"r2": {
			"accountId": "",
			"bucket": "nyaitter-uploads",
			"accessKeyId": "",
			"secretAccessKey": "",
			"publicDomain": ""
		}
	},
	"logging": {
		"level": "info",
		"pretty": true,
		"requestIdHeader": "x-request-id"
	},
	"rateLimit": {
		"enabled": true,
		"general": { "window": "1min", "max": 1000 },
		"auth": { "window": "1min", "max": 120 },
		"postWrite": { "window": "1min", "max": 30 },
		"profileUpdate": { "window": "1min", "max": 20 },
		"dmSend": { "window": "1min", "max": 60 },
		"upload": { "window": "1min", "max": 30 },
		"notification": { "window": "1min", "max": 60 },
		"reportCreate": { "window": "1min", "max": 10 },
		"reportAction": { "window": "1min", "max": 30 },
		"verificationApplication": { "window": "1min", "max": 5 }
		},
	"security": {
		"hsts": {
			"enabled": true,
				"maxAge": 31536000,
			"includeSubDomains": true
		},
		"helmet": {
			"enabled": false
		}
	},
	"health": {
		"detailed": false
	},
	"rules": {
		"filePath": "rule.nd"
	},
	"federation": {
		"publicUrl": "",
		"domain": "example.com",
		"allow_external_login": false,
		"trusted_servers": []
	}
}
