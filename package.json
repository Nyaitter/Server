    "express": "^4.19.2",
    "kuromoji": "^0.1.2",
    "pg": "^8.23.0",
    "sharp": "^0.35.3",
    "swagger-autogen": "^2.23.7",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^3.6.7",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "@emoji-mart/data": "1.2.1",
